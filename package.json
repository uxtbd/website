{
	"name": "website",
	"version": "1.0.0",
	"description": "personal website",
	"type": "module",
	"main": "index.js",
	"author": "uxtbd",
	"license": "MIT",
	"scripts": {
		"build": "prettier . -w && eleventy",
		"serve": "prettier . -w && eleventy --serve",
		"format": "prettier . -w",
		"lint": "eslint .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,mjs,ts,jsx,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md,toml,html,njk}": "prettier --write"
	},
	"dependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@inframanufaktur/eleventy-plugin-clean-urls": "^1.0.2",
		"eleventy-auto-cache-buster": "^0.9.2",
		"eleventy-plugin-github-repos": "^0.1.8",
		"eleventy-plugin-poison": "^1.0.1",
		"eleventy-plugin-reading-time": "^0.0.1",
		"eleventy-plugin-recent-changes": "^1.0.1",
		"eleventy-plugin-toc": "^1.1.5",
		"markdown-it": "^14.3.0",
		"markdown-it-anchor": "^9.2.1"
	},
	"devDependencies": {
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"prettier": "^3.9.6",
		"prettier-plugin-nunjucks": "^0.1.6"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.7.0",
			"onFail": "download"
		}
	}
}
